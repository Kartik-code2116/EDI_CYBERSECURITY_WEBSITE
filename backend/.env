# AI Security Assistant — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── App Settings ──────────────────────────────────────────────────────────────
APP_NAME="AI Security Assistant"
APP_VERSION="1.0.0"
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to true during development. Set to false in production.
ALLOW_ALL_ORIGINS=true

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=500

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/analysis.db

# ── AI / LLM Integration (optional) ──────────────────────────────────────────
# Uncomment and fill to enable AI explanations
# LLM_PROVIDER=gemini           # Options: gemini | openai | none
# GEMINI_API_KEY=your_key_here
# OPENAI_API_KEY=your_key_here
# LLM_MODEL=gemini-1.5-flash

# ── Risk Engine Weights ───────────────────────────────────────────────────────
# Must sum to 1.0
WEIGHT_URL=0.25
WEIGHT_PAGE=0.20
WEIGHT_VISION=0.30
WEIGHT_NLP=0.15
WEIGHT_BEHAVIOR=0.10

# ── Risk Thresholds ───────────────────────────────────────────────────────────
SAFE_THRESHOLD=30
SUSPICIOUS_THRESHOLD=60
DANGEROUS_THRESHOLD=80

# ── Vision Model (optional) ───────────────────────────────────────────────────
# Path to trained YOLO .pt model file
# VISION_MODEL_PATH=./models/vision/phishing_detector.pt

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
