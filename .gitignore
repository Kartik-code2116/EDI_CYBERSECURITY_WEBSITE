# ─────────────────────────────────────────────────────────────
#  ROOT — .gitignore
#  Covers ALL subprojects: server/, client/, backend/, extension/
#  ✅ Safe to commit: *.example, *.md, src/
#  🚫 NEVER commit: .env, node_modules, uploads, dist, logs
# ─────────────────────────────────────────────────────────────

# ── Secrets & environment (ALL subprojects) ──────────────────
# NEVER commit real credentials. Use .env.example as template.
.env
.env.local
.env.production
.env.staging
server/.env
client/.env
backend/.env
extension/.env

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# ── Build outputs ────────────────────────────────────────────
client/dist/
extension/dist/
backend/dist/
*.tsbuildinfo

# ── User uploaded files ──────────────────────────────────────
# PDFs, DOCX, and any user-submitted files — NOT source code
server/uploads/
backend/data/
uploads/

# ── Generated reports ────────────────────────────────────────
*.pdf
reports/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
backend/logs/
server/logs/

# ── Databases ────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── OS / Editor junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Test cache ───────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/


# Logs
*.log
npm-debug.log*

# Node (if ever run from root)
node_modules/
