# ─────────────────────────────────────────────────────────────
#  CLIENT — .gitignore
#  Files listed here are IGNORED by Git.
#  ✅  Safe to share with team → src/, public/, package.json
#  🚫  Never commit              → dist/, node_modules/
# ─────────────────────────────────────────────────────────────

# ── Dependencies ─────────────────────────────────────────────
# Re-installed via: npm install
node_modules/
package-lock.json

# ── Production build output ───────────────────────────────────
# Generated via: npm run build  — NOT source code
dist/
build/

# ── Local environment (if ever added) ────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Vite cache ───────────────────────────────────────────────
.vite/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / Editor junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
